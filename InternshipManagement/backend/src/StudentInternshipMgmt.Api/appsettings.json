{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StudentInternshipMgmtDb;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Jwt": {
  "Issuer": "StudentInternshipMgmt",
  "Audience": "StudentInternshipMgmt",
  "AccessTokenExpiryMinutes": 15,
  "RefreshTokenExpiryDays": 7
},
  "Import": {
    "MaxFileSizeBytes": 5242880,
    "MaxRows": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StudentInternshipMgmt.Api.Middlewares": "Information"
    }
  },
  "RecentRejectionDays": 14,
  "MaxOpenApplicationsPerStudent": 5,
  "ApplicationResponseDueDays": 7,
  "OverdueRequestAlertDays": 5,
  "InterviewResultOverdueDays": 3,
  "PlacementRequestExpiry": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "FromAddress": "",
    "FromName": ""
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "AllowedHosts": "*"
}
